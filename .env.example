# Copy this file's variable NAMES into Vercel's dashboard (Project -> Settings -> Environment Variables).
# Never commit real values here, and never paste real secret values into a chat -
# type them directly into the Vercel/Supabase/Shopify dashboards.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Shopify (store admin -> Settings -> Apps and sales channels -> Develop apps) ---
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=

# --- Cron job auth (any long random string you generate yourself) ---
CRON_SECRET=
